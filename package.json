{
  "name": "numerical-card-battle",
  "version": "1.4.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "verify": "node scripts/generate-catalog.js && node --test tests/*.test.js && node scripts/static-check.js",
    "verify:release": "npm run verify && npm run gate:v6-strength && npm run diversity",
    "gate:v6-strength": "node scripts/gate-v6-strength.js",
    "audit:v6-strength": "node scripts/audit-v6-strength.js",
    "migrate:presets-v6": "node scripts/migrate-presets-v6.js",
    "catalog": "node scripts/generate-catalog.js",
    "manifest": "node scripts/generate-manifest.js",
    "migrate:presets-v5": "node scripts/migrate-presets-v5.js && node scripts/apply-preset-names-v3.js",
    "apply:preset-names-v3": "node scripts/apply-preset-names-v3.js",
    "audit:naming": "node scripts/audit-naming-v3.js 10000",
    "audit:naming-v3": "node scripts/audit-naming-v3.js 10000",
    "audit:power-envelope": "node scripts/audit-v5-strength.js",
    "audit:presets-v5": "node scripts/audit-presets-v5.js",
    "audit:empirical-strength": "node scripts/empirical-strength-audit.js 1200 3000",
    "gen-mc": "node scripts/gen-mc.js",
    "diagnostics:legacy": "node scripts/health-metrics.js --n 3000 && node scripts/adjacent-rarity-matrix.js --seeds 48 --battles 8 && node scripts/matched-rarity-test.js --seeds 48 --battles 8 && node scripts/power-calibration.js --sample 600 --battles 14 --rarityN 48 && node scripts/similar-bp-test.js --battles 14 --pairs 120",
    "diversity": "node scripts/diversity-audit.js 3000",
    "diversity:v4": "node scripts/diversity-audit-v4.js 10000",
    "calibration:v4": "node scripts/power-v4-calibration.js 72 1600",
    "numerical-reference": "node scripts/generate-numerical-reference.js",
    "audit:numerical-coverage": "node scripts/audit-numerical-coverage.js 10000",
    "audit:numerical-semantics": "node scripts/audit-numerical-semantics.js"
  }
}
